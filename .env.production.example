# Copy to .env.production on the VM. Never commit real values.
DOMAIN=demo.example.com
POSTGRES_PASSWORD=replace-with-long-random-password
DATABASE_URL=postgres://underwriting:replace-with-long-random-password@postgres:5432/underwriting
MONGODB_URI=mongodb://mongo:27017
MONGODB_DB=underwriting_agent
BETTER_AUTH_URL=https://demo.example.com
BETTER_AUTH_SECRET=replace-with-at-least-32-random-characters
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
AUTH_ALLOWED_EMAILS=
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
# Optional integrations
BROWSERBASE_API_KEY=
ELEVENLABS_API_KEY=
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_ORG=astra-risk
SENTRY_PROJECT=astra-risk
SENTRY_AUTH_TOKEN=
FEDERATO_CLIENT_ID=
FEDERATO_CLIENT_SECRET=
