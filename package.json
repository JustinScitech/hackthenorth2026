{
  "name": "underwriting-review-agent",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev -p 3003",
    "build": "next build",
    "start": "next start",
    "worker": "node --env-file-if-exists=.env.local --env-file-if-exists=.env --import tsx src/agent/worker.ts",
    "db:migrate": "node --env-file-if-exists=.env.local --env-file-if-exists=.env --import tsx scripts/migrate.ts",
    "mongo:vector-index": "node --env-file-if-exists=.env.local --env-file-if-exists=.env --import tsx scripts/case-memory-index.ts",
    "mongo:backfill-memory": "node --env-file-if-exists=.env.local --env-file-if-exists=.env --import tsx scripts/case-memory-backfill.ts",
    "deploy:check": "node --env-file-if-exists=.env.local --env-file-if-exists=.env --import tsx scripts/deploy-check.ts",
    "typecheck": "tsc --noEmit",
    "eval:agent": "node --env-file-if-exists=.env.local --env-file-if-exists=.env --import tsx scripts/eval-agent.ts",
    "eval:underwriting": "node --import tsx scripts/eval-underwriting.ts",
    "eval": "node --env-file-if-exists=.env.local --env-file-if-exists=.env --import tsx evals/run.ts",
    "eval:update": "node --env-file-if-exists=.env.local --env-file-if-exists=.env --import tsx evals/run.ts --update-baseline",
    "test": "node --import tsx --test scripts/*.test.ts src/agent/*.test.ts src/app/ui/*.test.ts src/federato/*.test.ts src/lib/*.test.ts evals/*.test.ts",
    "test:e2e": "node --env-file-if-exists=.env --import tsx scripts/e2e-prepare.ts && npm run build && node --env-file-if-exists=.env ./node_modules/.bin/playwright test",
    "triage": "node --env-file-if-exists=.env.local --env-file-if-exists=.env --import tsx scripts/federato-triage.ts",
    "auth:check": "node --env-file-if-exists=.env.local --env-file-if-exists=.env --import tsx scripts/auth-check.ts",
    "eval:scorecard": "node --env-file-if-exists=.env.local --env-file-if-exists=.env --import tsx scripts/eval-scorecard.ts",
    "doctor": "node --env-file-if-exists=.env.local --env-file-if-exists=.env --import tsx scripts/doctor.ts",
    "smoke:case": "node --env-file-if-exists=.env.local --env-file-if-exists=.env --import tsx scripts/smoke-case.ts"
  },
  "dependencies": {
    "@browserbasehq/sdk": "^2.20.0",
    "@google/genai": "^2.23.0",
    "@phosphor-icons/react": "^2.1.10",
    "@sentry/nextjs": "^10.75.0",
    "@sentry/node": "^10.75.0",
    "better-auth": "^1.7.5",
    "lucide-react": "^0.468.0",
    "mongodb": "^7.6.0",
    "next": "^16.3.5",
    "pdfjs-dist": "^6.2.108",
    "pdfkit": "^0.20.2",
    "pg": "^8.16.0",
    "playwright-core": "^1.63.0",
    "pptxgenjs": "^4.0.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "three": "^0.186.0",
    "tsx": "^4.20.0",
    "zod": "^4.0.0"
  },
  "overrides": {
    "pptxgenjs": {
      "image-size": "^2.0.4"
    }
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/node": "^22.0.0",
    "@types/pdfkit": "^0.17.6",
    "@types/pg": "^8.15.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/three": "^0.186.0",
    "typescript": "^5.9.0"
  }
}
