{
  "name": "underwriting-review-agent",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev -p 3003",
    "build": "next build",
    "start": "next start",
    "worker": "node --env-file-if-exists=.env.local --env-file-if-exists=.env --import tsx src/agent/worker.ts",
    "db:migrate": "node --env-file-if-exists=.env.local --env-file-if-exists=.env --import tsx scripts/migrate.ts",
    "deploy:check": "node --env-file-if-exists=.env.local --env-file-if-exists=.env --import tsx scripts/deploy-check.ts",
    "typecheck": "tsc --noEmit",
    "eval:agent": "node --env-file-if-exists=.env.local --env-file-if-exists=.env --import tsx scripts/eval-agent.ts",
    "test": "node --import tsx --test scripts/*.test.ts src/agent/*.test.ts src/app/ui/*.test.ts src/federato/*.test.ts src/lib/*.test.ts",
    "test:e2e": "node --env-file=.env --import tsx scripts/e2e-prepare.ts && npm run build && node --env-file=.env ./node_modules/.bin/playwright test",
    "triage": "node --env-file-if-exists=.env.local --env-file-if-exists=.env --import tsx scripts/federato-triage.ts"
  },
  "dependencies": {
    "@browserbasehq/sdk": "^2.20.0",
    "@google/genai": "^2.23.0",
    "@sentry/node": "^10.75.0",
    "better-auth": "^1.7.5",
    "lucide-react": "^0.468.0",
    "mongodb": "^7.6.0",
    "next": "^16.3.5",
    "pg": "^8.16.0",
    "playwright-core": "^1.63.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "three": "^0.186.0",
    "tsx": "^4.20.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/node": "^22.0.0",
    "@types/pg": "^8.15.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/three": "^0.186.0",
    "typescript": "^5.9.0"
  }
}
