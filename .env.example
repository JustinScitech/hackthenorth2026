DATABASE_URL=postgres://underwriting:underwriting@localhost:5432/underwriting
DATABASE_SSL_REJECT_UNAUTHORIZED=true
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB=underwriting_agent
# Optional hosted connection strings. Set DATABASE_URL or MONGODB_URI to one of these only when you intend to use hosted storage.
TIGERDATA_DATABASE_URL=
MONGODB_ATLAS_URI=
BETTER_AUTH_URL=http://localhost:3003
BETTER_AUTH_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
AUTH_ALLOWED_EMAILS=
# Jobs without a worker: on Vercel the web app drains the queue itself (INLINE_JOBS defaults to
# on when deployed, off locally). CRON_SECRET is the bearer token for GET/POST /api/jobs/run.
INLINE_JOBS=
CRON_SECRET=
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
BROWSERBASE_API_KEY=
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=JBFqnCBsd6RMkjVDRZzb
# Sentry: the DSN is public and safe in the browser bundle; SENTRY_AUTH_TOKEN stays server-side.
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_ORG=astra-risk
SENTRY_PROJECT=astra-risk
SENTRY_AUTH_TOKEN=

# Organizer-issued credentials; never use NEXT_PUBLIC_ for these.
FEDERATO_CLIENT_ID=
FEDERATO_CLIENT_SECRET=
FEDERATO_AUTH_URL=https://auth.product.federato.ai/oauth/token
FEDERATO_AUDIENCE=https://product.federato.ai/core-api
FEDERATO_HANDLER_URL=https://product.federato.ai/integrations-api/handlers/federato-hack-north?outputOnly=true
# Optional override of schema-based Policy/Submission resource selection.
FEDERATO_RESOURCE=
# Optional JSON map of appetite concept names to discovered schema field paths.
FEDERATO_FIELD_MAP=
